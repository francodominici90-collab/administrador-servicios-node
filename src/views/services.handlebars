<section data-services-view="all">
  <h1>{{title}}</h1>
  <p>Consultá los servicios registrados y su disponibilidad.</p>

  <p class="summary">
    Servicios registrados:
    <strong id="services-count">{{services.length}}</strong>
  </p>

  <div id="services-list" class="services-grid">
    {{#each services}}
      <article class="service-card" data-service-id="{{id}}">
        <h2>{{name}}</h2>
        <p>{{description}}</p>

        <dl>
          <dt>Duración</dt>
          <dd>{{duration}} minutos</dd>

          <dt>Precio</dt>
          <dd>$ {{price}}</dd>

          <dt>Categoría</dt>
          <dd>{{category}}</dd>
        </dl>

        {{#if available}}
          <span class="badge badge-available">Disponible</span>
        {{else}}
          <span class="badge badge-unavailable">No disponible</span>
        {{/if}}
      </article>
    {{else}}
      <p class="empty-state">Todavía no hay servicios registrados.</p>
    {{/each}}
  </div>
</section>